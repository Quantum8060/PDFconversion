{
  "name": "pdf-image-converter",
  "version": "1.1.0",
  "description": "Windows desktop PDF to image converter",
  "main": "dist-electron/main/index.js",
  "author": "",
  "license": "MIT",
  "repository": "Quantum8060/PDFconversion",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package:win": "electron-builder --win dir",
    "installer:win": "node scripts/build-inno-installer.cjs",
    "dist:win": "npm run build && npm run package:win && npm run installer:win"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.57",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.personal.pdfimageconverter",
    "productName": "PDF Image Converter",
    "icon": "assets/app-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Quantum8060",
        "repo": "PDFconversion"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
